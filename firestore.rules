rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(groupId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    function validRound(data) {
      return data.teamA is list
        && data.teamB is list
        && data.teamA.size() == 2
        && data.teamB.size() == 2
        && data.teamA[0] is string
        && data.teamA[1] is string
        && data.teamB[0] is string
        && data.teamB[1] is string
        && data.teamAIds is list
        && data.teamBIds is list
        && data.teamAIds.size() == 2
        && data.teamBIds.size() == 2
        && data.teamAIds.toSet().size() == 2
        && data.teamBIds.toSet().size() == 2
        && data.teamAIds.toSet().intersection(data.teamBIds.toSet()).size() == 0
        && data.teamAIds[0] is string
        && data.teamAIds[1] is string
        && data.teamBIds[0] is string
        && data.teamBIds[1] is string
        && data.scoreA is int
        && data.scoreB is int
        && data.scoreA >= 0
        && data.scoreB >= 0;
    }

    match /groups/{groupId} {
      // Anyone who knows the invite code may read only the small group metadata
      // document in order to join. The player and match collections stay private.
      allow get: if signedIn()
        && (!exists(/databases/$(database)/documents/groups/$(groupId))
          || isMember(groupId)
          || resource.data.inviteCode == groupId);
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['inviteCode', 'memberIds', 'createdBy', 'createdAt'])
        && request.resource.data.inviteCode == groupId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];

      // A non-member can add only their own UID, using the exact invite code.
      allow update: if signedIn()
        && resource.data.inviteCode == groupId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.memberIds.size() <= 10
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && !(request.auth.uid in resource.data.memberIds);
      allow delete: if false;

      match /players/{playerId} {
        allow read: if isMember(groupId);
        allow create: if isMember(groupId)
          && request.resource.data.keys().hasOnly(['name', 'createdBy', 'createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if isMember(groupId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60;
        allow delete: if isMember(groupId);
      }

      match /matches/{matchId} {
        allow read: if isMember(groupId);
        allow create: if isMember(groupId)
          && request.resource.data.keys().hasOnly([
            'teamA', 'teamB', 'teamAIds', 'teamBIds',
            'scoreA', 'scoreB', 'createdBy', 'createdAt'
          ])
          && request.resource.data.createdBy == request.auth.uid
          && validRound(request.resource.data);

        // Existing members can correct round data, but cannot alter metadata.
        allow update: if isMember(groupId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'teamA', 'teamB', 'teamAIds', 'teamBIds', 'scoreA', 'scoreB'
          ])
          && validRound(request.resource.data);
        allow delete: if isMember(groupId);
      }
    }
  }
}
